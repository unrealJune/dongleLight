CONFIG_IDF_TARGET="esp32s3"

# Bluetooth: NimBLE, central + GATT server (needed so NimBLE dispatches
# incoming ATT notifications to BLE_GAP_EVENT_NOTIFY_RX without leaking mbufs)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4

# USB audio: stereo speaker uplink, mono microphone shared-state downlink
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_SPK_INTERVAL_MS=10
CONFIG_UAC_SPK_NEW_PLAY_INTERVAL=1000
CONFIG_UAC_TINYUSB_TASK_PRIORITY=7
CONFIG_UAC_TINYUSB_TASK_CORE=1
CONFIG_UAC_SPK_TASK_PRIORITY=8
CONFIG_UAC_SPK_TASK_CORE=1
CONFIG_UAC_MIC_TASK_PRIORITY=6
CONFIG_UAC_MIC_TASK_CORE=1
CONFIG_UAC_TUSB_PRODUCT="KS Light Bridge"
CONFIG_UAC_TUSB_MANUFACTURER="DIY"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
