menu "KS audio bridge"

    config KSA_NAME_PREFIX
        string "Only connect to lamps whose name starts with"
        default "KS"
        help
            Any advertised name matching a known KS profile AND this prefix is
            used. Narrow it (e.g. "KS03~1A2B") if several lamps are in range.

    config KSA_TARGET_ADDR
        string "Pin one lamp by BLE address (aa:bb:cc:dd:ee:ff), empty = any"
        default ""

    config KSA_DEBUG_NO_USB
        bool "Debug: skip USB audio, cycle colors every 4 s"
        default n
        help
            Keeps the USB serial/JTAG console alive (TinyUSB normally takes the
            USB port), so you can watch logs with idf.py monitor and confirm the
            Bluetooth half works before involving RDP.

    config KSA_LED_ENABLE
        bool "Drive the onboard APA102 status LED"
        default y

    config KSA_LED_DATA_GPIO
        int "APA102 data GPIO"
        depends on KSA_LED_ENABLE
        default 40

    config KSA_LED_CLK_GPIO
        int "APA102 clock GPIO"
        depends on KSA_LED_ENABLE
        default 39

endmenu
